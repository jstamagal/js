#!/usr/bin/env python3
"""Small command router for installed js wiki agents."""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path
from typing import NoReturn


HELP = """usage: wiki <command> [arguments] [-- <js options>]

commands:
  create <vault> [purpose]       create a vault with wiki-init
  ingest <vault> [--unit PATH] [instructions]
                                 ingest one bounded unit with wiki-ingest
  plan <vault> [goal]            compile and validate a workflow; do not run it
  flow <vault> [goal]            compile, validate, and run a workflow
  query <vault> <question>       query graph and raw sources
  lint <vault> [instructions]    audit and safely repair vault
  agent <name> [js arguments]    invoke any wiki agent directly
  help [command]                 show help

friendly examples:
  wiki create ~/wiki "terminal LLM harness engineering"
  wiki ingest ~/wiki --unit note.md
  wiki ingest ~/wiki "pick one inbox unit; focus on implementation decisions"
  wiki plan ~/wiki "group related sessions as projects"
  wiki flow ~/wiki
  wiki query ~/wiki "what changed this week?"
  wiki lint ~/wiki

Pass js options after `--`:
  wiki query ~/wiki "what supports this claim?" -- --model deepseek/deepseek-v4-flash --debug

Use `agent` for full control; arguments pass through unchanged:
  wiki agent wiki-query -C ~/wiki --model deepseek/deepseek-v4-flash --prompt "what changed?"

Worker sessions stay saved by js. Fresh friendly commands never set --session.
"""

COMMAND_HELP = {
    "create": "wiki create <vault> [purpose] [-- <js options>]",
    "ingest": "wiki ingest <vault> [--unit PATH] [instructions] [-- <js options>]",
    "plan": "wiki plan <vault> [goal] [-- <js options>]",
    "flow": "wiki flow <vault> [goal] [-- <js options>]",
    "query": "wiki query <vault> <question> [-- <js options>]",
    "lint": "wiki lint <vault> [instructions] [-- <js options>]",
    "agent": "wiki agent <name> [js arguments...]",
}


def fail(message: str, *, usage: str | None = None) -> NoReturn:
    print(f"wiki: {message}", file=sys.stderr)
    if usage:
        print(f"usage: {usage.removeprefix('wiki ')}", file=sys.stderr)
    raise SystemExit(2)


def js_executable() -> str:
    executable = os.environ.get("WIKI_JS") or shutil.which("js")
    if not executable:
        fail("js executable not found on PATH")
    return executable


def split_js_options(args: list[str]) -> tuple[list[str], list[str]]:
    if "--" not in args:
        return args, []
    index = args.index("--")
    return args[:index], args[index + 1 :]


def vault_path(raw: str, *, must_exist: bool = True) -> Path:
    vault = Path(raw).expanduser().resolve()
    if must_exist and not (vault / "PURPOSE.md").is_file():
        fail(f"{vault} is not a wiki vault (PURPOSE.md missing)")
    return vault


def existing_parent(path: Path) -> Path:
    current = path.parent
    while not current.exists() and current != current.parent:
        current = current.parent
    if not current.is_dir():
        fail(f"no existing parent directory for {path}")
    return current


def run_agent(agent: str, cwd: Path, prompt: str, js_options: list[str]) -> NoReturn:
    executable = js_executable()
    argv = [
        executable,
        "-C",
        str(cwd),
        "--agent",
        agent,
        *js_options,
        "--prompt",
        prompt,
    ]
    os.execvp(executable, argv)


def pop_unit(args: list[str]) -> tuple[str | None, list[str]]:
    if "--unit" not in args:
        return None, args
    index = args.index("--unit")
    if index + 1 >= len(args):
        fail("--unit needs a path", usage=COMMAND_HELP["ingest"])
    unit = args[index + 1]
    return unit, args[:index] + args[index + 2 :]


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] in {"help", "-h", "--help"}:
        if len(args) > 1:
            command = args[1]
            if command not in COMMAND_HELP:
                fail(f"unknown command: {command}")
            print(COMMAND_HELP[command])
        else:
            print(HELP, end="")
        return 0

    command = args.pop(0)
    if command == "agent":
        if not args:
            fail("agent name required", usage=COMMAND_HELP["agent"])
        agent = args.pop(0)
        executable = js_executable()
        os.execvp(executable, [executable, "--agent", agent, *args])

    if command not in COMMAND_HELP:
        fail(f"unknown command: {command}")

    friendly, js_options = split_js_options(args)
    if not friendly:
        fail("vault path required", usage=COMMAND_HELP[command])

    if command == "create":
        vault = vault_path(friendly.pop(0), must_exist=False)
        purpose = " ".join(friendly).strip() or (
            "Infer a practical purpose from the vault name and nearby context; "
            "if unclear, create a broad general-knowledge vault."
        )
        prompt = (
            f"Create wiki vault at {vault}. Purpose/domain: {purpose} "
            "Create complete vault contract and initialize git only when not nested in another repository."
        )
        run_agent("wiki-init", existing_parent(vault), prompt, js_options)

    vault = vault_path(friendly.pop(0))

    if command == "ingest":
        unit, instructions = pop_unit(friendly)
        scope = f"Exact unit: {unit}." if unit else "Pick one top-level inbox unit."
        extra = " ".join(instructions).strip()
        prompt = (
            f"Vault: {vault}. {scope} Ingest one bounded unit completely through wiki_finish_ingest. "
            "Do not touch another inbox unit."
            + (f" Additional instructions: {extra}" if extra else "")
        )
        run_agent("wiki-ingest", vault, prompt, js_options)

    if command in {"plan", "flow"}:
        goal = " ".join(friendly).strip()
        action = (
            "Compile and validate workflow only; do not launch worker js instances."
            if command == "plan"
            else "Compile, validate, and launch workflow. Generated workflow owns all worker js instances."
        )
        prompt = f"Vault: {vault}. Inspect actual inbox. {action}"
        if goal:
            prompt += f" Goal: {goal}"
        run_agent("wiki-flow", vault, prompt, js_options)

    if command == "query":
        question = " ".join(friendly).strip()
        if not question:
            fail("question required", usage=COMMAND_HELP["query"])
        run_agent("wiki-query", vault, f"Vault: {vault}. Question: {question}", js_options)

    if command == "lint":
        instructions = " ".join(friendly).strip()
        prompt = f"Audit and safely repair wiki vault at {vault}. Follow safe-fix boundary."
        if instructions:
            prompt += f" Additional instructions: {instructions}"
        run_agent("wiki-lint", vault, prompt, js_options)

    raise AssertionError(f"unhandled command: {command}")


if __name__ == "__main__":
    raise SystemExit(main())
