# js config baked into the bench sandbox. Provider, model, and base URL come
# from the environment (sandbox.sh forwards JS_*), so this only carries the
# limits, mirroring the owner's daily jsrc so the bench measures the same js.
set EFFORT high
set TURN_ROUNDS_MAX 99
set SHELL_OUTPUT_MAX 40000
set TOOL_RESULT_MAX 262144
set TOOL_RESULT_INLINE_MAX 51200
set READ_LINES_MAX 2000
set READ_BYTES_MAX 262144
set PARALLEL_RESULTS_MAX 200000
fset TRACE off
set COMPACTION_AUTO on
set CONTEXT_SIZE_UNKNOWN 128000
