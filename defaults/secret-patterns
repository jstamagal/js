# secret-patterns: what counts as a secret token.
#
# Two readers share this file: envctx's scrubber (tools/envctx.c), which
# redacts shell history and git output before they reach a prompt, and the
# -u key detector (js/secret_patterns.py), which decides whether the text
# after the last colon of `-u ...model:KEY@host` is a key. A line added here
# teaches both.
#
# js reads ~/.js/secret-patterns when it exists, otherwise this file.
#
# One rule per line. Fields are separated by spaces or tabs. Blank lines and
# lines starting with # are skipped. A line js cannot read is an error that
# names the file and line.
#
#   class NAME CHARS
#       Names a character set for the rules below it. CHARS lists characters
#       and ranges: A-Z is a range, a - first or last is a plain -.
#
#   prefix PREFIX MIN MAX CLASS
#       A token that starts with PREFIX, followed by MIN to MAX characters
#       all from CLASS, is a secret. envctx prints it as <key:PREFIX..>,
#       naming the longest matching PREFIX.
#
#   entropy MIN KINDS CLASS
#       A token no prefix rule matches is a secret when it is at least MIN
#       characters long, every character is from CLASS, it has a digit, and
#       it mixes at least KINDS of: lowercase letters, uppercase letters,
#       digits. envctx prints it as <secret:Nb>.
#
#   exempt LEN CLASS
#       A token of exactly LEN characters, all from CLASS, is never an
#       entropy secret. Prefix rules still apply to it.

class key    A-Za-z0-9_-
class token  A-Za-z0-9_.~+/=-
class blob   A-Za-z0-9_+/=-
class upnum  A-Z0-9
class hex    0-9a-f

# Model providers.
prefix sk-ant-      4 512 key
prefix sk-or-       4 512 key
prefix sk-          4 512 key
prefix nvapi-       7 512 key
prefix gsk_         7 512 key
prefix xai-         7 512 key
prefix hf_          7 512 key
prefix r8_          7 512 key
prefix anthropic-   7 512 key
prefix AIza         7 512 key
prefix ya29.        7 512 token

# Code hosts and package registries.
prefix ghp_         7 512 key
prefix gho_         7 512 key
prefix ghu_         7 512 key
prefix ghs_         7 512 key
prefix ghr_         7 512 key
prefix github_pat_  7 512 key
prefix glpat-       7 512 key
prefix npm_         7 512 key
prefix pypi-        7 512 token

# Payments, chat, cloud and hosting.
prefix sk_live_     7 512 key
prefix sk_test_     7 512 key
prefix rk_live_     7 512 key
prefix pk_live_     7 512 key
prefix xoxb-        7 512 key
prefix xoxp-        7 512 key
prefix xoxa-        7 512 key
prefix xapp-        7 512 key
prefix AKIA         7 512 upnum
prefix ASIA         7 512 upnum
prefix sbp_         7 512 key
prefix dop_v1_      7 512 key
prefix SG.          7 512 token
prefix shpat_       7 512 key
prefix Bearer       7 512 token

# JSON web tokens.
prefix eyJ          22 4096 token

# Long mixed blobs with no known prefix.
entropy 40 2 blob
entropy 32 3 blob

# A full git SHA-1 is 40 lowercase hex characters: common in shell history and
# not a secret. A 64-hex token stays a secret.
exempt 40 hex
