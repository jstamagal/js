# js/fset: the /fset defaults. Every line here is an `fset NAME value` line,
# the same lines a jsrc carries and /save writes. A theme (THEME, a file of
# PALETTE_nn lines in ~/.js/themes or js/themes) sits over these; the
# operator's own fset lines sit over the theme. No theme is set here.
#
# A message's format defaults to its js/messages.py text; the ones below
# differ from it.

# What each part of the screen is drawn in: a palette slot, so a theme's
# palette repaints it. Empty is the terminal's own colour.
fset COLOR_BACKGROUND ""
fset COLOR_DIM 14
fset COLOR_USER ""
fset COLOR_USER_MARK $HOST_COLOR|11
fset COLOR_AGENT 13
fset COLOR_AGENT_MARK $HOST_COLOR|$COLOR_AGENT
