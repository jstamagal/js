fset COLOR_WARN #8a6116
fset COLOR_ERROR #c62828
fset COLOR_OK #2e7d32
fset COLOR_TOOL #333436
fset COLOR_TOOL_OUTPUT #191a1c
fset COLOR_PANEL #eef2f7
fset COLOR_ACCENT #0433d2
