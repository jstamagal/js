fset COLOR_DIM #56585c
fset COLOR_USER #191a1c
fset COLOR_USER_MARK $HOST_COLOR|$COLOR_USER
fset COLOR_AGENT #0a2fb9
fset COLOR_AGENT_MARK $HOST_COLOR|$COLOR_AGENT
