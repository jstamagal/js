################################################################################
#
#   ~/.js/jsrc  --  your js settings
#
#   Every setting js has is listed below, commented out, at the value js uses
#   when you don't touch it. To change one, delete the `#` in front of its
#   `set` line and edit the value. Or change it live with `/set` inside js and
#   type `/save`: /save finds the setting's line here, uncomments it with your
#   value, and leaves every other line, comment and blank in this file alone.
#
#   If you set something back to its stock value and /save, its line is
#   commented out again. /save never writes a backup copy of this file.
#
#   Syntax:
#       set SOME_SETTING value      give a setting a value
#       set -SOME_SETTING           clear it (nothing set, js decides)
#       #set SOME_SETTING value     commented out: js ignores the line
#
#   Who wins when the same setting is set in more than one place,
#   weakest first:
#       js's stock values  <  this file  <  .js/jsrc in the project
#       <  .js/jsrc.local in the project  <  JS_* environment variables
#       <  js --extra key=value
#
#   Every setting also reads an environment variable named after it:
#   FETCH_TIMEOUT -> JS_FETCH_TIMEOUT, REASONING_DISPLAY -> JS_REASONING_DISPLAY, and
#   so on.
#
#   Inside js:  /set              list every setting and its current value
#               /set NAME         one setting's value
#               /set compaction   one group;  /set *_FILE  names that match
#               /help set NAME    what a setting does
#
################################################################################


################################################################################
#  MODEL  --  which model answers, and how hard it thinks
################################################################################

# The model js talks to when you don't pass -m. Write it as
# provider/model. The provider part is the name of a login in
# ~/.js/logins/logins.toml or a provider js knows. A bare model name with no
# provider/ in front goes to the Vercel AI Gateway.
#   example:  set MODEL cpa/claude-opus-5-5
#   example:  set MODEL deepseek/deepseek-v4-flash
#set MODEL deepseek/deepseek-v4-flash

# How hard the model thinks before it answers. From least to most:
#   off      no thinking at all
#   minimal  barely
#   low      a little
#   medium   moderate
#   high     a lot
#   xhigh    more than high
#   max      as much as the model allows
# More thinking: slower, more tokens, often better on hard problems.
# Unset: the provider's own default for that model. An agent's agent.yaml
# can set its own effort, and a one-shot `js -p` uses that.
#   example:  set EFFORT medium
#set -EFFORT

# Largest reply the model may write in one call, in tokens. Thinking counts
# toward it. Unset: the model's own limit from the model catalog, or no
# limit sent at all if the catalog doesn't know the model.
#   example:  set OUTPUT_TOKENS_MAX 32000
#set -OUTPUT_TOKENS_MAX

# The model's context window in tokens: how much conversation it can hold.
# js uses this number to decide when the conversation is getting full and
# needs compacting. Set it when the catalog has it wrong, or when your
# endpoint gives you a different size than the public one. This one number
# applies to whatever model is active. To set different sizes for different
# models, use CONTEXT_SIZE_PER_MODEL instead.
#   example:  set CONTEXT_SIZE 1000000
#set -CONTEXT_SIZE

# Only for Anthropic-format endpoints, and only for older models that think
# against a token budget: Claude 4.5 and earlier, MiniMax, opencode-go.
# This is the budget in tokens. Newer Claude models think adaptively and
# ignore it. Unset: js picks a budget from EFFORT.
#   example:  set THINKING_BUDGET 16000
#set -THINKING_BUDGET

# Whether js sends images to the model.
#   on      always send the image itself
#   off     never send images
#   unset   js guesses from what the catalog says the model can see
# Turn it on when your model can see images but js doesn't know that.
#   example:  set VISION on
#set -VISION


################################################################################
#  PROVIDER  --  where the requests go
################################################################################

# Force a provider instead of reading it from MODEL. It's the name of a
# login from `js login` or a provider js knows: deepseek, openai-codex,
# ollama, cpa ...
#   example:  set PROVIDER cpa
#set -PROVIDER

# Force the address requests go to. Leave the API path off the end when the
# login talks Anthropic format: js adds /v1/messages itself, so
# http://host:8999/v1 there becomes /v1/v1/messages and fails with a 404.
# OpenAI-format endpoints usually do want the /v1.
#   example:  set BASE_URL http://vader:8999
#set -BASE_URL

# Force the API key. Unset: the key from your login or the provider's usual
# environment variable. This file is plain text, so prefer `js login`.
#   example:  set API_KEY sk-...
#set -API_KEY

# Request headers sent with every model call, on top of the login's own.
# Like curl -H; several separated by ';' or newlines. Unset: none.
#   example:  set EXTRA_HEADERS X-JS-Scrub: on; X-Pool: fofa
#set -EXTRA_HEADERS

# How much js hides keys. off: nothing hidden, keys show as typed and in
# full. on: prompts don't echo keys and /set, js --login, logs and search
# errors mask them. extra: on, and every model call asks the CLIProxyAPI
# secret-scrub plugin to swap keys for placeholders.
#   example:  set PARANOID_MODE on
#set PARANOID_MODE off

# Extra fields js adds to every request body, as JSON. For provider options
# js has no setting for.
#   example:  set EXTRA_PARAMS {"include_reasoning": true}
#   example:  set EXTRA_PARAMS {"top_a": 0.1}
#set EXTRA_PARAMS {}


################################################################################
#  AGENT
################################################################################

# The agent js runs when you don't pass --agent. It's a directory name under
# ~/.js/agents/. Read when js starts, so a change applies to the next run.
#   example:  set DEFAULT_AGENT forge
#set DEFAULT_AGENT defaultagent


################################################################################
#  SCREEN  --  what you see while js works
################################################################################

# What starts each line js prints about its own state, such as the answer
# to /set.
#   example:  set BANNER -!-
#set BANNER ***

# A message of the day, shown above the startup line when the REPL starts.
# ANSI colours in it show (TheDraw .ANS, chafa output); cursor moves do not. MOTD_FILE is one file of
# entries split by lines holding only %, like fortune(6); one is picked at
# random. MOTD_DIR is a directory of art files; one is picked at random.
# MOTD_FILE wins when both are set. Unset: no MOTD.
#   example:  set MOTD_DIR ~/art
#set -MOTD_FILE
#set -MOTD_DIR

# The model's thinking, on screen.
#   0  hidden; you never see it
#   1  streams in while it thinks, then folds into one line,
#      `N tok reasoning`, when the answer starts
#   2  streams in and stays on screen
#   3  like 2, plus the provider's token count when the thinking ends
# Ctrl-O folds and unfolds the thinking whatever the level. Only the screen
# folds: in js -p and the blocking REPL, 1 to 3 print the thinking and then
# its token count. The thinking is kept either way.
#   example:  fset REASONING_DISPLAY 2
#fset REASONING_DISPLAY 1

# Network chatter, on screen.
#   0  nothing, not even errors
#   1  failures only
#   2  also "Connecting" and "Connected" lines, and a byte counter in the
#      status bar until the first word of the answer arrives
#   3  also retries, model catalog refreshes and per-call stream stats
#   example:  fset NET_DISPLAY 0
#fset NET_DISPLAY 2

# How tool calls look on screen.
#   0  you don't see them
#   1  just the important part: quick calls (reads, searches) fold into one
#      row per tool, a shell command shows its output while it runs and then
#      shrinks to one row, an edit shows its diff, a failure shows its error
#   2  every call, with the first few lines of each result
#      (TOOLS_PREVIEW_LINES)
#   3  every call, with its whole result
#   example:  fset TOOLS_DISPLAY 2
#fset TOOLS_DISPLAY 1

# How many lines of a result or a diff TOOLS_DISPLAY 1 and 2 show before hiding
# the rest.
#   example:  fset TOOLS_PREVIEW_LINES 30
#fset TOOLS_PREVIEW_LINES 12

# Tools TOOLS_DISPLAY 1 counts as quick: each folds into one row instead of
# showing its result. A JSON list of tool names.
#   example:  fset TOOLS_QUIET ["read", "fs_search"]
#fset TOOLS_QUIET ["read", "fs_search", "ast_search", "lsp", "fetch", "browse", "browser_probe", "exa_search", "serper_search", "tavily_search", "docs_search", "claim", "release", "subscribe", "wake_me", "who", "tasks", "take_task", "tool_discovery", "skill", "undo", "terminal_snapshot"]

# Shell commands TOOLS_DISPLAY 1 counts as quick, matched by the command's first
# word or first two words. A JSON list.
#   example:  fset SHELL_QUIET ["ls", "cat", "git status"]
#fset SHELL_QUIET ["cd", "ls", "cat", "head", "tail", "wc", "pwd", "tree", "stat", "file", "which", "find", "fd", "grep", "rg", "du", "df", "ps", "echo", "sort", "uniq", "git status", "git log", "git diff", "git show", "git branch"]

# Draw the model's Markdown (headings, bold, code blocks) on screen.
#   on   each block is drawn formatted once it's finished
#   off  raw text exactly as it arrives
# Output going to a pipe or a file is always raw.
#   example:  fset MARKDOWN off
#fset MARKDOWN on

# When you resume a session, how many of its last exchanges are shown
# again before the prompt. 0 shows none.
#   example:  fset RESUME_EXCHANGES 10
#fset RESUME_EXCHANGES 3

# Keys on the input line.
#   emacs  Enter sends the line
#   vi     a multi-line box; Esc then :x sends, Esc then : opens a command
#          line
#   example:  set EDITING_MODE vi
#set EDITING_MODE emacs


# --- colours, palette and formats ---

# How everything looks is /fset: `/fset` lists it, `/fset THEME bitchx`
# picks a built-in theme (claude, crush, bitchx, github, paper, splash3),
# `/fset COLOR_STATUS_BACKGROUND #1e1e2e` changes one colour, and /save
# writes your fset lines here.
#   example:  fset HOST_COLOR #0000aa


# --- pasting ---

# The key that pastes an image from the clipboard into your message. It
# shows up as [image #N] and is sent with the line. Key names look like
# c-v (Ctrl-V) or escape v (Esc then V). Clear it to bind no key.
#   example:  set PASTE_IMAGE_KEY escape v
#set PASTE_IMAGE_KEY c-v

# The command js runs to get the clipboard image. Unset:
# `wl-paste --type image/png` on Wayland,
# `xclip -selection clipboard -t image/png -o` on X11.
#   example:  set PASTE_IMAGE_COMMAND xclip -selection clipboard -t image/png -o
#set -PASTE_IMAGE_COMMAND

# A paste longer than this many lines shows in the input line as one
# [paste #N +X lines] marker so it doesn't flood your screen. The whole
# text is still sent. 0: no line limit.
#   example:  set PASTE_COLLAPSE_LINES 40
#set PASTE_COLLAPSE_LINES 10

# Same as above, counted in characters. When both are 0, pastes are never
# collapsed.
#set PASTE_COLLAPSE_CHARS 1000


################################################################################
#  PROMPT HISTORY  --  Up arrow and Ctrl-R
################################################################################

# Where every line you type at the prompt is saved, for all js runs.
# Unset: ~/.js/state/history.jsonl
#set -HISTORY_FILE

# Up arrow order.
#   last  every line, newest first
#   cwd   lines you typed in this directory come first, newest first, then
#         the rest
# Ctrl-R searches all of them either way.
#   example:  set HISTORY_ORDER cwd
#set HISTORY_ORDER last

# How many past lines are loaded for Up and Ctrl-R.
#set HISTORY_SIZE 10000


################################################################################
#  KEYS
################################################################################

# A file of key changes: `bind KEY... ACTION` and `unbind KEY...`, one per
# line. Actions: submit, history_search, ex_open, ex_run, ex_cancel,
# interrupt, eof, suspend, reasoning_toggle, redraw, scroll_up,
# scroll_down, complete.
# Unset: ~/.js/keys when it exists.
#   example line in that file:  bind c-t reasoning_toggle
#set -KEYBINDS_FILE


################################################################################
#  TOOLS  --  how far the model can go in one turn
################################################################################

# Most tool calls the model may make in one turn before js stops it with
# "Tool loop hit max iterations".
#   example:  set TURN_ROUNDS_MAX 1000
#set TURN_ROUNDS_MAX 500

# Most separate tool calls js accepts from one reply. Exact duplicates are
# merged first. The rest are refused with a note to the model.
#set REPLY_TOOL_CALLS_MAX 50

# How many read-only calls from one reply run at the same time (reads,
# searches, fetches). A call that writes always runs alone, in order.
# 1: everything runs one after another.
#set PARALLEL_TOOLS_MAX 8

# Whether the model may hand work to subagents, and how deep: a subagent
# starting its own subagent is depth 2.
#set SUBAGENT_DEPTH_MAX 2

# Most subagents one task call runs at once.
#set SUBAGENT_WORKERS_MAX 8

# Subagents run on your current model instead of the one their own agent
# names.
#set SUBAGENT_INHERIT_MODEL off

# Stop the model from choosing which model a subagent runs on.
#set SUBAGENT_MODEL_LOCK off

# In a swarm, how many agents may be in the middle of a turn at the same
# time. 0: no limit.
#set SWARM_ACTIVE_MAX 0


################################################################################
#  TOOL OUTPUT SIZES  --  how much a tool result can hand the model
################################################################################

# Most shell output the model sees from one command, stdout and stderr
# together, in bytes. Past that it gets the start and the end, plus the path
# of a file holding all of it.
#   example:  set SHELL_OUTPUT_MAX 1000000
#set SHELL_OUTPUT_MAX 262144

# A tool result bigger than this many bytes is saved to a file, and the
# model gets a preview plus the path, so nothing is cut off and lost.
# 0: off.
#set TOOL_RESULT_INLINE_MAX 51200

# Hard cap on the text of any single tool result, in bytes. Past it, the
# result is cut. Images and audio don't count; TOOL_MEDIA_MAX caps them.
#set TOOL_RESULT_MAX 262144

# Cap on each image or audio a tool returns, in bytes of base64 data. A
# bigger one is dropped with a line that says why. 0: no cap.
#set TOOL_MEDIA_MAX 5242880

# Cap on all results from one batch of parallel calls added together, in
# bytes. The biggest results are cut first. 0: no cap.
#set PARALLEL_RESULTS_MAX 200000


################################################################################
#  READING FILES
################################################################################

# Most lines one read() returns.
#set READ_LINES_MAX 2000

# Biggest file read() will read whole, in bytes. A read that asks for a
# line range or a byte range works on any size file.
#set READ_BYTES_MAX 262144

# Biggest file the other file tools (search and friends) will open.
#set FILE_BYTES_MAX 2000000

# A text file you attach to a message is cut at this many bytes.
#set ATTACHMENT_MAX 65536

# How many lines of each cell output read() shows for a notebook (.ipynb).
# The rest are counted, not shown. 0: just what kind of output each one is.
#set NOTEBOOK_OUTPUT_LINES_MAX 10


################################################################################
#  WEB
################################################################################

# How long one fetch() may take, in seconds, start to finish. Also the
# timeout for the web search tools.
#   example:  set FETCH_TIMEOUT 60
#set FETCH_TIMEOUT 15

# How long browse() may spend loading a page, in seconds. The browser gives
# up a second early so whatever did load is still returned.
#set BROWSE_TIMEOUT 60

# How long a file download (fetch with save=, or anything binary or huge)
# may take, in seconds.
#set DOWNLOAD_TIMEOUT 300

# Biggest file fetch(save=...) may download, in bytes. 0: no limit; a
# download goes straight to disk, so even a huge one is fine.
#set DOWNLOAD_MAX 0

# The User-Agent fetch and the web searches send.
#   example:  set HTTP_USER_AGENT Mozilla/5.0
#set HTTP_USER_AGENT js-agent/0.1

# The TypeSafe model the jev tool asks.
#set JEV_MODEL jev-latest


################################################################################
#  SHELL
################################################################################

# The shell the model's commands run in: a name on your PATH, or a full
# path. bash and zsh run with pipefail, so a pipeline fails when any part
# of it fails.
#   example:  set SHELL_PROGRAM zsh
#set SHELL_PROGRAM bash

# How long a shell call waits for its command to finish before handing the
# model a handle to check back with. The command keeps running; nothing is
# killed.
#   example:  set SHELL_WAIT 120
#set SHELL_WAIT 30

# Environment variables every shell command gets without the model having
# to ask for each one. A JSON list of names.
#   example:  set SHELL_ENV_KEEP ["PATH", "HOME", "USER", "TERM", "GITHUB_TOKEN"]
#set SHELL_ENV_KEEP ["PATH", "HOME", "USER", "LANG", "LC_ALL", "TERM", "PWD", "SHELL", "BEADS_ACTOR"]

# Only when you run `js -C DIR`, which locks commands inside DIR: more paths
# the commands can still see. A JSON list. "path" is read-only, "path:rw" is
# read-write. Paths that don't exist are skipped.
#   example:  set JAIL_BIND ["~/.gitconfig", "~/notes:rw"]
#set JAIL_BIND ["~/.gitconfig", "~/.config/git", "~/.local/share/uv", "~/.cache/uv:rw"]

# Only with `js -C DIR`: paths that are always empty inside, whatever DIR
# and JAIL_BIND show, so a jail rooted at your home still shows no keys.
#   example:  set JAIL_HIDE ["~/.js", "~/.ssh", "~/work/secrets"]
#set JAIL_HIDE ["~/.js", "~/.ssh", "~/.gnupg", "~/.netrc", "~/.aws", "~/.config/gh"]


################################################################################
#  KERNEL  --  the model's persistent Python session
################################################################################

# How much of each kernel call you see on screen. The model always gets the
# full result.
#   quiet    only errors and interrupts
#   normal   code, output, timing, variables
#   verbose  also stdout, stderr and displays split apart, plus kernel
#            start and stop
#fset KERNEL_VERBOSITY normal

# Enable kernel and toolbox after installing the kernel extra:
#   uv sync --extra kernel
#set PYTHON_KERNEL off

# Most lines shown per part of a kernel result on screen, so one huge
# output can't scroll everything away. The model still gets all of it.
#fset KERNEL_LINES_MAX 24

# How long a kernel call waits for its code before handing the model a
# handle to check back with. The code keeps running.
#set PYTHON_KERNEL_WAIT 5


################################################################################
#  INLINE CODE IN PROMPT FILES
################################################################################

# Run !{sh ...}, !{python ...}, !{c ...}, !{node ...} and ```!lang blocks
# found in prompt files and put their output into the prompt. That runs
# code from those files every time.
#   off  never run them
#set INLINE_CODE on

# How long one of those may run, in seconds.
#set INLINE_CODE_TIMEOUT 300


################################################################################
#  WHEN THINGS FAIL  --  retries and cut-off replies
################################################################################

# How many times js retries a request that failed in a way worth retrying:
# rate limited (429), a server error (5xx), or a stream that dropped or
# went quiet. It waits as long as the provider asks, otherwise 1s, 2s, 4s,
# 8s, then 16s each time. 0: give up on the first error.
#set RETRY_COUNT_MAX 10

# Longest wait js accepts when a provider says "retry after N seconds". If
# it asks for longer, js fails right away instead. 0: wait as long as asked.
#set RETRY_WAIT_MAX 120

# A request that gets no data for this many seconds is dropped and retried.
# Keep-alive pings count as data. 0: wait forever.
#set STREAM_IDLE_TIMEOUT 300

# js -p: after this many seconds with nothing shown, a line on stderr says
# what runs now and for how long, and again after each further stretch.
# 0: off.
#set PROGRESS_INTERVAL 30

# A reply cut off at its token limit is sent once more with this bigger
# limit, when that's bigger than what was used and the model allows it.
# 0: never.
#set OUTPUT_TOKENS_RETRY_MAX 64000

# After a reply gets cut off, how many times per turn js keeps what was
# written and tells the model to carry on. 0: the turn just ends at the cut.
#set OUTPUT_RESUMES_MAX 3


################################################################################
#  TYPING WHILE THE MODEL WORKS
################################################################################

# What happens to a line you type while a turn is running.
#   now    it reaches the model at its next tool call, as a message from
#          you; if no tool call is left, after the turn ends
#   batch  everything you typed goes in as one message after the turn ends
#   one    each line becomes its own turn, in order
#set STEER_MODE now


################################################################################
#  LOGS
################################################################################

# Keep a full log of every request in ~/.js/logs/<agent>/<session>.log:
# the whole system prompt, the tool definitions and every message sent.
# It's only written to the file, never shown.
#set REQUEST_LOG on

# Where that log goes. Unset: ~/.js/logs/<agent>
#set -REQUEST_LOG_DIR

# Keep a copy of what printed on your screen in
# ~/.js/logs/transcript/<agent>/<session>.log
#set TRANSCRIPT_LOG on

# Where that copy goes. Unset: ~/.js/logs/transcript/<agent>
#set -TRANSCRIPT_LOG_DIR

# Long-term memory from a Hy-Memory server (js/hymem_server.py). Set to its
# URL to turn it on: sessions are sent to it 10 turns at a time, the first
# message of `js -p` and of a swarm agent carries the memories matching its
# task, and the memory_search tool searches them. Unset: off.
#set -HYMEM_URL

# Whose memories these are on the server. Unset: your login name.
#set -HYMEM_USER

# Most memories a first message carries, and memory_search returns.
#set HYMEM_RECALL_MAX 8

# A memory is passed on when Jev judges, 0 to 1, that it helps the task by
# at least this much.
#set HYMEM_RELEVANCE_MIN 0.5

# Without Jev (no TYPESAFE_API_KEY, or no answer): the memory server's own
# match score a memory needs instead.
#set HYMEM_SCORE_MIN 0.6

# In `js -p`, print a short line for each tool call while it runs.
#   off  you only see the final answer
#fset TRACE on

# Write a record of every internal event to state/<agent>/debug.log. Only
# for chasing a js bug.
#set DEBUG_LOG off


################################################################################
#  COMPACTION  --  keeping long conversations under the context limit
################################################################################

# When a conversation gets close to the model's context limit, js shrinks
# it. First it clears old tool results. If that's not enough, it has a model
# write a summary of the older part and keeps the recent part word for word.

# Shrink automatically.
#   off  only when you type /compact
#set COMPACTION_AUTO on

# How full the conversation is, from 0 to 1, when js
#   tells you once:
#set COMPACTION_WARN_AT 0.5
#   starts compacting:
#set COMPACTION_START_AT 0.8
#   compacts no matter what:
#set COMPACTION_FORCE_AT 0.9
# They have to go up in that order, or js ignores all three and uses the
# stock values.

# Context windows for specific models, as JSON. Write the key as
# "provider/model" or just "model"; provider/model wins.
#   example:  set CONTEXT_SIZE_PER_MODEL {"cpa/claude-opus-5-5": 1000000, "qwen27b": 131072}
#set CONTEXT_SIZE_PER_MODEL {}

# Window to assume only for a model js can't find a size for. Models it
# does know aren't affected.
#set CONTEXT_SIZE_UNKNOWN 1000000

# Most tokens set aside for the model's next reply when js works out how
# full things are. It uses the smaller of this and the model's real output
# limit, so a model that claims a 128k reply can't eat a third of the
# window.
#set COMPACTION_REPLY_RESERVE_TOKENS 20000

# Extra tokens of headroom kept free on top of that.
#set COMPACTION_HEADROOM_TOKENS 4096

# How much of the most recent conversation is kept word for word after a
# summary, in tokens.
#set COMPACTION_KEEP_RECENT_TOKENS 16384

# Skip compacting unless it would save at least this many tokens.
#set COMPACTION_MIN_SAVINGS_TOKENS 400

# When clearing old tool results, this many of the newest stay whole.
#set COMPACTION_KEEP_TOOL_RESULTS 20

# Prompt cache lifetime, in seconds. If your last request was at least this
# long ago, the cache is gone anyway, so js clears old tool results first;
# if it was sooner, js summarizes first so the cache isn't thrown away.
# 0: always clear first.
#set COMPACTION_CACHE_TTL 300

# The model that writes the summary. "same" means the one you're using.
#   example:  set COMPACTION_EXTERNAL_MODEL deepseek/deepseek-v4-flash
#set COMPACTION_EXTERNAL_MODEL same

# Longest summary allowed, in tokens. It can't go over 8192.
#set COMPACTION_SUMMARY_TOKENS_MAX 8192

# Tool results sent to the summary model are cut to this many characters,
# keeping the start and the end. 0: send them whole.
#set COMPACTION_SUMMARY_RESULT_CHARS_MAX 2000

# After this many automatic summaries fail in a row, automatic compaction
# pauses. A successful /compact turns it back on.
#set COMPACTION_FAILURES_MAX 3

# After a summary, files the model had read recently are attached again,
# newest first, so it doesn't lose them. How many:
#set COMPACTION_REATTACH_FILES_MAX 5

# The most tokens all those re-attached files may use together.
#set COMPACTION_REATTACH_TOKENS_MAX 50000

# A file bigger than this many tokens is named but not re-attached.
#set COMPACTION_REATTACH_FILE_TOKENS_MAX 5000

# A shell command whose output js gives to the summary model as extra
# instructions.
#   example:  set COMPACTION_HINT_COMMAND cat ~/notes/what-matters.md
#set -COMPACTION_HINT_COMMAND

# Where js keeps a full copy of the conversation from just before each
# compaction. Unset: ~/.js/logs/<agent>/compactions
#set -COMPACTION_LOG_DIR

# Characters per token js assumes until it learns the real ratio from the
# provider.
#set COMPACTION_CHARS_PER_TOKEN 4.0


################################################################################
#  EXEC AND EVENT HANDLERS  --  `exec` commands and `on` lines
################################################################################

# Most seconds an exec command may run before js kills it. When an `on`
# handler runs it, whatever triggered the handler waits that long too.
# 0: no limit.
#set EXEC_TIMEOUT 30

