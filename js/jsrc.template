################################################################################
#  LANGUAGE SERVERS  --  the lsp tool
################################################################################

# Language servers the lsp tool may start, as JSON. For a file, js uses the
# first one whose extensions include the file's and whose program is
# installed. "roots" are the files that mark a project's top directory;
# without any, the nearest directory with .git in it.
#set LSP_SERVERS [{"name": "basedpyright", "command": ["basedpyright-langserver", "--stdio"], "extensions": [".py", ".pyi"], "roots": ["pyproject.toml", "setup.py", "setup.cfg", "pyrightconfig.json"]}, {"name": "pyright", "command": ["pyright-langserver", "--stdio"], "extensions": [".py", ".pyi"], "roots": ["pyproject.toml", "setup.py", "setup.cfg", "pyrightconfig.json"]}, {"name": "rust-analyzer", "command": ["rust-analyzer"], "extensions": [".rs"], "roots": ["Cargo.toml"]}, {"name": "gopls", "command": ["gopls"], "extensions": [".go"], "roots": ["go.work", "go.mod"]}, {"name": "typescript-language-server", "command": ["typescript-language-server", "--stdio"], "extensions": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"], "roots": ["tsconfig.json", "jsconfig.json", "package.json"]}]

# How long an lsp call waits for its server to start or answer, in seconds.
#set LSP_TIMEOUT 30


################################################################################
#  MCP SERVERS
################################################################################

# MCP servers js connects to, as JSON. A local server gets command, args
# and env; a server over HTTP gets url and headers.
#   example:  set MCP_SERVERS {"files": {"command": "python", "args": ["/opt/files-mcp.py"]}}
#   example:  set MCP_SERVERS {"api": {"url": "http://127.0.0.1:8765/mcp", "headers": {"Authorization": "Bearer xyz"}}}
#set MCP_SERVERS {}

# Which agents may use which MCP servers and tools, as JSON. allow and deny
# lists take wildcards.
#   example:  set MCP_AGENT_POLICY {"forge": {"servers": {"allow": ["files"]}, "tools": {"deny": ["*__delete*"]}}}
#set MCP_AGENT_POLICY {}

# How long a request to an MCP server waits for its answer, in seconds.
#set MCP_TIMEOUT 10.0


################################################################################
#  TOOL NAMES AND TERMINALS
################################################################################

# Give tools different names for particular models, as JSON. "match" is
# checked against the model and provider names; the first profile that
# matches is used.
#   example:  set TOOL_ALIASES [{"match": "qwen", "aliases": {"read": "read_file"}}]
#set -TOOL_ALIASES

# Size of a terminal_session the model starts without giving one.
#set TERMINAL_COLUMNS 64
#set TERMINAL_ROWS 36


################################################################################
#  SAMPLING  --  only sent if you set them
################################################################################

# Unset means js doesn't send the value at all and the provider uses its own
# default. Set one only if your provider accepts it. Many reasoning models
# reject temperature and top_p outright.

# Randomness. Lower is more predictable, higher is more varied.
#   example:  set TEMPERATURE 0.7
#set -TEMPERATURE

# Only pick from the most likely words that add up to this probability.
#   example:  set TOP_P 0.95
#set -TOP_P

# Only pick from this many of the most likely words.
#   example:  set TOP_K 40
#set -TOP_K

# Push back on repeating the same words. 1.0 is no push.
#   example:  set REPETITION_PENALTY 1.1
#set -REPETITION_PENALTY

# Push toward words that haven't been used yet. 0 is no push.
#   example:  set PRESENCE_PENALTY 0.5
#set -PRESENCE_PENALTY


