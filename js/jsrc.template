################################################################################
#  SESSION TAGS  --  short topic labels on your saved sessions
################################################################################

# js asks a small model (Jev, through TypeSafe) to tag each session from its
# last few messages. No TYPESAFE_API_KEY means no tagging.

# The list of tags to choose from: one `name: description` per line.
# Unset: ~/.js/tags.yaml if you made one, else the list that ships with js.
# Edit the list and every session is tagged again next time one ends.
#set -tags.file

# How sure Jev has to be, 0 to 1, before a tag sticks.
#   example:  set tags.threshold 0.8
#set tags.threshold 0.6

# The most tags one session gets. The surest win.
#set tags.max 3

# How many of the session's last messages (yours and the model's) are sent
# to be tagged. Tool output is never sent.
#set tags.messages 10

# Each of those messages is cut to this many characters.
#set tags.message_chars 2000

# The TypeSafe model that does the tagging.
#set tags.model jev-latest


################################################################################
#  TOOLS  --  how far the model can go in one turn
################################################################################

# Most tool calls the model may make in one turn before js stops it with
# "Tool loop hit max iterations".
#   example:  set limits.max_tool_iterations 1000
#set limits.max_tool_iterations 500

# Most separate tool calls js accepts from one reply. Exact duplicates are
# merged first. The rest are refused with a note to the model.
#set limits.max_tool_calls_per_message 50

# How many read-only calls from one reply run at the same time (reads,
# searches, fetches). A call that writes always runs alone, in order.
# 1: everything runs one after another.
#set runtime.max_parallel_tools 8

# Whether the model may hand work to subagents, and how deep: a subagent
# starting its own subagent is depth 2.
#set limits.task_max_depth 2

# Most subagents one task call runs at once.
#set limits.subagent_max_workers 8

# Subagents run on your current model instead of the one their own agent
# names.
#set subagents.prefer_inherit off

# Stop the model from choosing which model a subagent runs on.
#set subagents.lock_model off

# In a swarm, how many agents may be in the middle of a turn at the same
# time. 0: no limit.
#set swarm.slots 0


################################################################################
#  TOOL OUTPUT SIZES  --  how much a tool result can hand the model
################################################################################

# Most shell output the model sees from one command, stdout and stderr
# together, in bytes. Past that it gets the start and the end, plus the path
# of a file holding all of it.
#   example:  set limits.max_bash_output_bytes 1000000
#set limits.max_bash_output_bytes 262144

# A second cap on shell output, in bytes. The model gets whichever of this
# and limits.max_bash_output_bytes is smaller. 0: no second cap.
#set limits.max_bash_output_ceiling 150000

# A tool result bigger than this many bytes is saved to a file, and the
# model gets a preview plus the path, so nothing is cut off and lost.
# 0: off.
#set limits.max_tool_result_inline_bytes 51200

# Hard cap on any single tool result, in bytes. Past it, the result is cut.
#set limits.max_tool_result_bytes 262144

# Cap on all results from one batch of parallel calls added together, in
# bytes. The biggest results are cut first. 0: no cap.
#set limits.max_tool_results_per_turn_bytes 200000


################################################################################
#  READING FILES
################################################################################

# Most lines one read() returns.
#set limits.max_read_lines 2000

# Biggest file read() will read whole, in bytes. A read that asks for a
