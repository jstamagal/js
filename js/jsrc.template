#set jail.bind ["~/.gitconfig", "~/.config/git", "~/.local/share/uv", "~/.cache/uv:rw"]


################################################################################
#  KERNEL  --  the model's persistent Python session
################################################################################

# How much of each kernel call you see on screen. The model always gets the
