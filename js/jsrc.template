################################################################################
#
#   ~/.js/jsrc  --  your js settings
#
#   Every setting js has is listed below, commented out, at the value js uses
#   when you don't touch it. To change one, delete the `#` in front of its
#   `set` line and edit the value. Or change it live with `/set` inside js and
#   type `/save`: /save finds the setting's line here, uncomments it with your
#   value, and leaves every other line, comment and blank in this file alone.
#
#   If you set something back to its stock value and /save, its line is
#   commented out again. /save never writes a backup copy of this file.
#
#   Syntax:
#       set some.setting value      give a setting a value
#       set -some.setting           clear it (nothing set, js decides)
#       #set some.setting value     commented out: js ignores the line
#
#   Who wins when the same setting is set in more than one place,
#   weakest first:
#       js's stock values  <  this file  <  .js/jsrc in the project
#       <  .js/jsrc.local in the project  <  JS_* environment variables
#       <  js --extra key=value
#
#   Every setting also reads an environment variable named after it:
#   ui.reasoning -> JS_UI_REASONING, limits.fetch_timeout_s ->
#   JS_LIMITS_FETCH_TIMEOUT_S, and so on.
#
#   Inside js:  /set              list every setting and its current value
#               /show <setting>   one setting, with its help text
#
################################################################################


################################################################################
#  MODEL  --  which model answers, and how hard it thinks
################################################################################

# The model js talks to when you don't pass -m. Write it as
# provider/model. The provider part is the name of a login in
# ~/.js/logins/logins.toml or a provider js knows. A bare model name with no
# provider/ in front goes to the Vercel AI Gateway.
#   example:  set model.id cpa/claude-opus-5-5
#   example:  set model.id deepseek/deepseek-v4-flash
#set model.id deepseek/deepseek-v4-flash

# How hard the model thinks before it answers. From least to most:
#   off      no thinking at all
#   minimal  barely
#   low      a little
#   medium   moderate
#   high     a lot
#   xhigh    more than high
#   max      as much as the model allows
# More thinking: slower, more tokens, often better on hard problems.
# Unset: the provider's own default for that model. An agent's agent.yaml
# can set its own effort, and a one-shot `js -p` uses that.
#   example:  set model.reasoning_effort medium
#set -model.reasoning_effort

# Largest reply the model may write in one call, in tokens. Thinking counts
# toward it. Unset: the model's own limit from the model catalog, or no
# limit sent at all if the catalog doesn't know the model.
#   example:  set model.max_output_tokens 32000
#set -model.max_output_tokens

# The model's context window in tokens: how much conversation it can hold.
# js uses this number to decide when the conversation is getting full and
# needs compacting. Set it when the catalog has it wrong, or when your
# endpoint gives you a different size than the public one. This one number
# applies to whatever model is active. To set different sizes for different
# models, use compact.context_window_overrides instead.
#   example:  set model.context_window 1000000
#set -model.context_window

# Only for Anthropic-format endpoints, and only for older models that think
# against a token budget: Claude 4.5 and earlier, MiniMax, opencode-go.
# This is the budget in tokens. Newer Claude models think adaptively and
# ignore it. Unset: js picks a budget from model.reasoning_effort.
#   example:  set model.thinking_budget 16000
#set -model.thinking_budget

# Whether js sends images to the model.
#   on      always send the image itself
#   off     never send images
#   unset   js guesses from what the catalog says the model can see
# Turn it on when your model can see images but js doesn't know that.
#   example:  set model.vision on
#set -model.vision


################################################################################
#  PROVIDER  --  where the requests go
################################################################################

# Force a provider instead of reading it from model.id. It's the name of a
# login from `js login` or a provider js knows: deepseek, openai-codex,
# ollama, cpa ...
#   example:  set provider.id cpa
#set -provider.id

# Force the address requests go to. Leave the API path off the end when the
# login talks Anthropic format: js adds /v1/messages itself, so
# http://host:8999/v1 there becomes /v1/v1/messages and fails with a 404.
# OpenAI-format endpoints usually do want the /v1.
#   example:  set provider.base_url http://vader:8999
#set -provider.base_url

# Force the API key. Unset: the key from your login or the provider's usual
# environment variable. This file is plain text, so prefer `js login`.
#   example:  set provider.api_key sk-...
#set -provider.api_key

# Extra fields js adds to every request body, as JSON. For provider options
# js has no setting for.
#   example:  set provider.extra {"include_reasoning": true}
#   example:  set provider.extra {"top_a": 0.1}
#set provider.extra {}


################################################################################
#  AGENT
################################################################################

# The agent js runs when you don't pass --agent. It's a folder name under
# ~/.js/agents/. Read when js starts, so a change applies to the next run.
#   example:  set agent forge
#set agent defaultagent


################################################################################
#  SCREEN  --  what you see while js works
################################################################################

# The model's thinking, on screen.
#   0  hidden; you never see it
#   1  streams in while it thinks, then folds into one line when the answer
#      starts
#   2  streams in and stays on screen
#   3  like 2, plus a token count when the thinking ends
# Ctrl-O folds and unfolds the thinking whatever the level. This only
# changes the screen; the thinking is kept either way.
#   example:  set ui.reasoning 1
#set ui.reasoning 2

# Network chatter, on screen.
#   0  nothing, not even errors
#   1  failures only
#   2  also "Connecting" and "Connected" lines, and a byte counter in the
#      status bar until the first word of the answer arrives
#   3  also retries, model catalog refreshes and per-call stream stats
#   example:  set ui.net 0
#set ui.net 2

# How tool calls look on screen.
#   0  you don't see them
#   1  just the important part: quick calls (reads, searches) fold into one
#      row per tool, a shell command shows its output while it runs and then
#      shrinks to one row, an edit shows its diff, a failure shows its error
#   2  every call, with the first few lines of each result
#      (ui.tools_preview_lines)
#   3  every call, with its whole result
#   example:  set ui.tools 2
#set ui.tools 1

# How many lines of a result or a diff ui.tools 1 and 2 show before hiding
# the rest.
#   example:  set ui.tools_preview_lines 30
#set ui.tools_preview_lines 12

# Tools ui.tools 1 counts as quick: each folds into one row instead of
# showing its result. A JSON list of tool names.
