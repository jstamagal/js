#   example:  set ui.shell_quiet ["ls", "cat", "git status"]
#set ui.shell_quiet ["cd", "ls", "cat", "head", "tail", "wc", "pwd", "tree", "stat", "file", "which", "find", "fd", "grep", "rg", "du", "df", "ps", "echo", "sort", "uniq", "git status", "git log", "git diff", "git show", "git branch"]

# Draw the model's Markdown (headings, bold, code blocks) on screen.
#   on   each block is drawn formatted once it's finished
#   off  raw text exactly as it arrives
# Output going to a pipe or a file is always raw.
#   example:  set ui.markdown off
#set ui.markdown on

# When you resume a session, how many of its last exchanges are shown
