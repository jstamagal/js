#set limits.shell_env_allow ["PATH", "HOME", "USER", "LANG", "LC_ALL", "TERM", "PWD", "SHELL", "BEADS_ACTOR"]

# Only when you run `js -C DIR`, which locks commands inside DIR: more paths
