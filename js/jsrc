# js built-in defaults: one line per registered setting.
#
# This file is the lowest config layer. Precedence, lowest to highest:
#   js/jsrc (this file) < ~/.js/jsrc < .js/jsrc < .js/jsrc.local
#   < env vars < --extra
# `set -NAME` leaves a setting unset. `/set` with no argument lists every setting
# and its value; `/help set NAME` says what one does.

# --- model ---
set DEFAULT_AGENT defaultagent
set MODEL deepseek/deepseek-v4-flash
set -OUTPUT_TOKENS_MAX
set -CONTEXT_SIZE
set -EFFORT
set -THINKING_BUDGET
set -VISION

# --- banner ---
set BANNER ***
set -MOTD_FILE
set -MOTD_DIR

# --- ui ---
set ui.reasoning 2
set ui.net 2
set ui.status_bg #00007f
set ui.status_fg #ffffff
set ui.tools 1
set ui.tools_preview_lines 12
set ui.tools_quiet ["read", "fs_search", "ast_search", "lsp", "fetch", "browse", "browser_probe", "exa_search", "serper_search", "tavily_search", "docs_search", "claim", "release", "subscribe", "wake_me", "who", "tasks", "take_task", "tool_discovery", "skill", "undo", "terminal_snapshot"]
set ui.shell_quiet ["cd", "ls", "cat", "head", "tail", "wc", "pwd", "tree", "stat", "file", "which", "find", "fd", "grep", "rg", "du", "df", "ps", "echo", "sort", "uniq", "git status", "git log", "git diff", "git show", "git branch"]
set theme.accent #1fb4ff
set theme.ok #00c555
set theme.error #ff8aa7
set theme.warn #e59500
set theme.dim #b8b4c2
set theme.panel #2d2c35
set theme.panel_text #e1e0e5
set theme.added #00c555
set theme.removed #ff8aa7
set theme.code #ff8aa7
set ui.markdown on
set ui.resume_exchanges 3
set EDITING_MODE emacs
set PASTE_IMAGE_KEY c-v
set PASTE_COLLAPSE_LINES 10
set PASTE_COLLAPSE_CHARS 1000
set -PASTE_IMAGE_COMMAND

# --- history ---
set -HISTORY_FILE
set HISTORY_ORDER last
set HISTORY_SIZE 10000

# --- keys ---
set -KEYBINDS_FILE

# --- provider ---
set -PROVIDER
set -BASE_URL
set -API_KEY
set -EXTRA_HEADERS
set PARANOID_MODE off
set EXTRA_PARAMS {}

# --- limits ---
set TURN_ROUNDS_MAX 500
set REPLY_TOOL_CALLS_MAX 50
set SHELL_OUTPUT_MAX 262144
set TOOL_RESULT_INLINE_MAX 51200
set TOOL_RESULT_MAX 262144
set FETCH_TIMEOUT 15
set SHELL_ENV_KEEP ["PATH", "HOME", "USER", "LANG", "LC_ALL", "TERM", "PWD", "SHELL", "BEADS_ACTOR"]
set BROWSE_TIMEOUT 60
set DOWNLOAD_TIMEOUT 300
set DOWNLOAD_MAX 0
set INLINE_CODE_TIMEOUT 300
set READ_LINES_MAX 2000
set FILE_BYTES_MAX 2000000
set ATTACHMENT_MAX 65536
set READ_BYTES_MAX 262144
set PARALLEL_RESULTS_MAX 200000
set SUBAGENT_DEPTH_MAX 2
set SUBAGENT_WORKERS_MAX 8

# --- swarm ---
set SWARM_ACTIVE_MAX 0

# --- kernel ---
set PYTHON_KERNEL off
set kernel.verbosity normal
set kernel.render_max_lines 24
set PYTHON_KERNEL_WAIT 5

# --- shell ---
set SHELL_PROGRAM bash
set SHELL_WAIT 30

# --- jail ---
set JAIL_BIND ["~/.gitconfig", "~/.config/git", "~/.local/share/uv", "~/.cache/uv:rw"]
set JAIL_HIDE ["~/.js", "~/.ssh", "~/.gnupg", "~/.netrc", "~/.aws", "~/.config/gh"]

# --- runtime ---
set DEBUG_LOG off
set runtime.trace on
set PARALLEL_TOOLS_MAX 8
set RETRY_COUNT_MAX 10
set RETRY_WAIT_MAX 120
set STREAM_IDLE_TIMEOUT 300
set PROGRESS_INTERVAL 30
set OUTPUT_TOKENS_RETRY_MAX 64000
set OUTPUT_RESUMES_MAX 3
set STEER_MODE now
set REQUEST_LOG on
set -REQUEST_LOG_DIR
set TRANSCRIPT_LOG on
set -TRANSCRIPT_LOG_DIR
set INLINE_CODE on

# --- events ---
set EXEC_TIMEOUT 30
set EXEC_OUTPUT_MAX 65536

# --- compact ---
set COMPACTION_AUTO on
set -COMPACTION_LOG_DIR
set CONTEXT_SIZE_PER_MODEL {}
set CONTEXT_SIZE_UNKNOWN 1000000
set COMPACTION_WARN_AT 0.5
set COMPACTION_START_AT 0.8
set COMPACTION_FORCE_AT 0.9
set COMPACTION_HEADROOM_TOKENS 4096
set COMPACTION_REPLY_RESERVE_TOKENS 20000
set COMPACTION_KEEP_RECENT_TOKENS 16384
set COMPACTION_MIN_SAVINGS_TOKENS 400
set COMPACTION_KEEP_TOOL_RESULTS 20
set COMPACTION_REATTACH_FILES_MAX 5
set COMPACTION_REATTACH_TOKENS_MAX 50000
set COMPACTION_REATTACH_FILE_TOKENS_MAX 5000
set COMPACTION_CHARS_PER_TOKEN 4.0
set COMPACTION_EXTERNAL_MODEL same
set COMPACTION_SUMMARY_TOKENS_MAX 8192
set COMPACTION_SUMMARY_RESULT_CHARS_MAX 2000
set COMPACTION_FAILURES_MAX 3
set COMPACTION_CACHE_TTL 300
set -COMPACTION_HINT_COMMAND

# --- subagents ---
set SUBAGENT_INHERIT_MODEL off
set SUBAGENT_MODEL_LOCK off

# --- tools ---
set -TOOL_ALIASES
set HTTP_USER_AGENT js-agent/0.1
set JEV_MODEL jev-latest
set TERMINAL_COLUMNS 64
set TERMINAL_ROWS 36

# --- lsp ---
set LSP_SERVERS [{"name": "basedpyright", "command": ["basedpyright-langserver", "--stdio"], "extensions": [".py", ".pyi"], "roots": ["pyproject.toml", "setup.py", "setup.cfg", "pyrightconfig.json"]}, {"name": "pyright", "command": ["pyright-langserver", "--stdio"], "extensions": [".py", ".pyi"], "roots": ["pyproject.toml", "setup.py", "setup.cfg", "pyrightconfig.json"]}, {"name": "rust-analyzer", "command": ["rust-analyzer"], "extensions": [".rs"], "roots": ["Cargo.toml"]}, {"name": "gopls", "command": ["gopls"], "extensions": [".go"], "roots": ["go.work", "go.mod"]}, {"name": "typescript-language-server", "command": ["typescript-language-server", "--stdio"], "extensions": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"], "roots": ["tsconfig.json", "jsconfig.json", "package.json"]}]
set LSP_TIMEOUT 30

# --- notebook ---
set NOTEBOOK_OUTPUT_LINES_MAX 10

# --- mcp ---
set MCP_SERVERS {}
set MCP_AGENT_POLICY {}
set MCP_TIMEOUT 10.0

# --- sampling ---
set -TEMPERATURE
set -TOP_P
set -TOP_K
set -REPETITION_PENALTY
set -PRESENCE_PENALTY
