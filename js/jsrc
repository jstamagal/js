# js built-in defaults: one line per registered setting.
#
# This file is the lowest config layer. Precedence, lowest to highest:
#   js/jsrc (this file) < ~/.js/jsrc < .js/jsrc < .js/jsrc.local
#   < env vars < --extra
# `set -NAME` leaves a setting unset. `/set` with no argument lists every setting
# and its value; `/help set NAME` says what one does.

# --- model ---
set DEFAULT_AGENT defaultagent
set MODEL deepseek/deepseek-v4-flash
set -OUTPUT_TOKENS_MAX
set -CONTEXT_SIZE
set -EFFORT
set -THINKING_BUDGET
set -VISION

# --- banner ---
set BANNER ***
set -MOTD_FILE
set -MOTD_DIR

